from gpiozero import LED, MotionSensor
from time import sleep
led = LED(18)
pir = MotionSensor(17)
print('Waiting for motion...')
while True:
    pir.wait_for_motion()
    print('Motion Detected!')
    led.on()
    sleep(2)
    led.off()
    print('LED OFF')





#IR
from gpiozero import DigitalInputDevice
from time import sleep
# IR sensor output pin to GPIO 17
ir_sensor = DigitalInputDevice(17) 

print("IR Sensor Test...")
try:
    while True:
        if ir_sensor.value == 0:   # 0 = Object detected
            print("Object Detected")
        else:
            print("No Object")
        sleep(1)
except KeyboardInterrupt:
    print("\nTest stopped.")


IR Sensor Module to Raspberry Pi 5

IR Module Pin	Connect to Raspberry Pi 5
VCC	3.3V or 5V (depending on module specifications; most modules support 3.3V)
GND	GND
OUT (Output)	GPIO 17 (Physical Pin 11)
Obstacle Indicator LED

LED	Connect to
Anode (Long leg)	GPIO 23 (Physical Pin 16)
Cathode (Short leg)	GND (via a 220Ω or 330Ω current-limiting resistor)






#LM35
from gpiozero import MCP3008
from time import sleep
# LM35 on CH0 of MCP3008
lm35 = MCP3008(channel=0) 
print("Reading temperature...")

try:
    while True:
        # Read the raw value (0.0 to 1.0) and convert to voltage
        voltage = lm35.value * 3.3          
        
        # LM35 gives 10mV per degree Celsius, so multiply by 100
        temp = voltage * 100                
        
        print(f"Temperature: {temp:.2f} °C")
        sleep(2)

except KeyboardInterrupt:
    print("\nTest stopped.")




MCP3008 to Raspberry Pi 5 (SPI Interface)

MCP3008 Pin	Connect to Raspberry Pi 5
VDD (Pin 16)	3.3V (Physical Pin 1 or 17)
VREF (Pin 15)	3.3V (Physical Pin 1 or 17)
AGND (Pin 14)	GND
DGND (Pin 9)	GND
CLK (Pin 13)	GPIO 11 / SCLK (Physical Pin 23)
DOUT (Pin 12)	GPIO 9 / MISO (Physical Pin 21)
DIN (Pin 11)	GPIO 10 / MOSI (Physical Pin 19)
CS/SHDN (Pin 10)	GPIO 8 / CE0 (Physical Pin 24)


LM35 to MCP3008

LM35 Pin	Connect to
VCC (Power)	3.3V (can share with MCP3008's VDD)
GND	GND
VOUT (Output)	CH0 on MCP3008
Temperature Indicator LED

LED	Connect to
Anode (Long leg)	GPIO 18 (Physical Pin 12)
Cathode (Short leg)	GND (via a 220Ω or 330Ω current-limiting resistor)
