from flask import Flask, render_template
from gpiozero import Button, LED
from gpiozero.pins.lgpio import LGPIOFactory
from gpiozero import Device

# Force the use of the lgpio backend, required for Raspberry Pi 5
Device.pin_factory = LGPIOFactory()

app = Flask(__name__)

# Hardware initialization
button = Button(26, bounce_time=0.05)
led_list = [LED(17), LED(18)]

for led in led_list:
    led.off()

@app.route("/")
def index():
    # Pass the status of the first LED to the template
    return render_template("main.html", led_state=led_list[0].is_lit)

@app.route("/push-button")
def check_push_button():
    if button.is_pressed:
        return "button is pressed"
    return "button is not pressed"

# Fix the route to match the HTML buttons
@app.route("/led/on")
def led_on():
    led_list[0].on()
    return render_template("main.html", led_state=True)

@app.route("/led/off")
def led_off():
    led_list[0].off()
    return render_template("main.html", led_state=False)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)





